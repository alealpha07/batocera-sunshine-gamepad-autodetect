#!/usr/bin/python
import os
import re
import sys
import time

ORIGINAL_LAUNCHER = "/var/run/sunshine-gamepad-autodetect/emulatorlauncher"
LOG_FILE = "/userdata/system/logs/sunshine-gamepad-autodetect.log"
LOG_MAX_BYTES = 256 * 1024
REMOTE_PAD_MARKER = "sunshine"
PLAYER_ARG = re.compile(r"^-p([1-8])([a-z]+)$")


def log(message):
    try:
        if os.path.exists(LOG_FILE) and os.path.getsize(LOG_FILE) > LOG_MAX_BYTES:
            os.remove(LOG_FILE)
        with open(LOG_FILE, "a") as log_file:
            log_file.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} | {message}\n")
    except OSError:
        pass


def split_player_args(args):
    players = {}
    other_args = []
    position = 0
    while position < len(args):
        match = PLAYER_ARG.match(args[position])
        if match and position + 1 < len(args):
            players.setdefault(int(match.group(1)), {})[match.group(2)] = args[position + 1]
            position += 2
        else:
            other_args.append(args[position])
            position += 1
    return [players[number] for number in sorted(players)], other_args


def is_remote_pad(player):
    return REMOTE_PAD_MARKER in player.get("name", "").lower()


def remote_pads_first(players):
    remote_pads = [player for player in players if is_remote_pad(player)]
    local_pads = [player for player in players if not is_remote_pad(player)]
    return remote_pads + local_pads


def join_player_args(players, other_args):
    args = []
    for number, player in enumerate(players, 1):
        for field, value in player.items():
            args += [f"-p{number}{field}", value]
    return args + other_args


def describe(players):
    return ", ".join(f"P{number}={player.get('name', '?').strip()}" for number, player in enumerate(players, 1)) or "no pads"


def reorder_args(args):
    players, other_args = split_player_args(args)
    reordered_players = remote_pads_first(players)
    if reordered_players == players:
        log(f"unchanged: {describe(players)}")
        return args
    log(f"{describe(players)} -> {describe(reordered_players)}")
    return join_player_args(reordered_players, other_args)


def main():
    args = sys.argv[1:]
    try:
        args = reorder_args(args)
    except Exception as error:
        log(f"reorder failed, launching unchanged: {error!r}")

    if os.path.exists(ORIGINAL_LAUNCHER):
        os.execv(sys.executable, [sys.executable, ORIGINAL_LAUNCHER] + args)

    from configgen.emulatorlauncher import launch
    sys.argv = [sys.argv[0]] + args
    sys.exit(launch())


if __name__ == "__main__":
    main()
